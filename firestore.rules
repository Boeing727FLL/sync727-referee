rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email.lower() == 'boeing727.il@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users: owners see all, users see and edit only themselves.
    // Signup creates the doc, so any signed-in user may create their own doc
    // with a fixed shape (role is always 'member' — never self-assignable).
    // Later edits are limited to the display name only.
    match /users/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt', 'role', 'uid'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 180
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.role == 'member'
        && request.resource.data.createdAt is timestamp;
      allow update: if (isOwner() || isSelf(userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if isOwner() || isSelf(userId);
    }

    // App config (rulebook, corrections, whitelists): public read for the app to work,
    // writes for the owner only.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // API keys pool: readable by signed-in app users only, writable by owner only.
    // Entries are ENC1 sealed envelopes (see src/lib/keyVault.ts), never plaintext.
    match /secrets/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Per-user daily chat quota (server-enforced): self-only, strictly +1 per
    // question inside a rolling 24h window, capped. See src/lib/chatQuota.ts.
    match /chat_quota/{userId} {
      allow get: if isSelf(userId) || isOwner();
      allow list: if false;
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['count', 'windowStart'])
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time;
      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['count', 'windowStart'])
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100
        && (
          ((request.time - resource.data.windowStart) < duration.value(24, 'h')
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.windowStart == resource.data.windowStart)
          ||
          ((request.time - resource.data.windowStart) >= duration.value(24, 'h')
            && request.resource.data.count == 1
            && request.resource.data.windowStart == request.time)
        );
      allow delete: if false;
    }

    // Password collections: owner only, no public access at all.
    match /app_passwords/{docId} {
      allow read, write: if isOwner();
    }

    // Q&A journal: owner-only. Entries are written by the app's analytics
    // helper (RTDB mirror) — this Firestore collection is not read by clients.
    match /referee_logs/{logId} {
      allow read, write: if isOwner();
    }

    // Feedback: owner-only. Same as above — clients write via RTDB.
    match /referee_feedback/{feedbackId} {
      allow read, write: if isOwner();
    }

    // Counters mirror: owner-only (the live counters live in RTDB).
    match /analytics/{docId} {
      allow read, write: if isOwner();
    }

    // Single-session lock: a user may only touch their own session doc,
    // so nobody can kick anyone else offline anymore.
    match /sessions/{userId} {
      allow read, write: if isSelf(userId) || isOwner();
    }

    // Presence heartbeats mirror: owner reads, signed-in users manage entries.
    match /presence/{sessionId} {
      allow read: if isOwner();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Legacy team-app collections live in the same project but are not used
    // by the referee app at all: locked to the owner on both reads and writes.
    match /experts/{expertId} {
      allow read, write: if isOwner();
      match /messages/{messageId} {
        allow read, write: if isOwner();
      }
      match /files/{fileId} {
        allow read, write: if isOwner();
      }
      match /push_subscriptions/{subId} {
        allow read, write: if isOwner();
      }
    }

    match /push_subscriptions/{subId} {
      allow read, write: if isOwner();
    }

    match /tasks/{taskId} {
      allow read, write: if isOwner();
    }

    match /sprint_tasks/{taskId} {
      allow read, write: if isOwner();
    }

    match /budget_items/{itemId} {
      allow read, write: if isOwner();
    }

    match /forms/{formId} {
      allow read, write: if isOwner();
    }

    match /sponsors/{sponsorId} {
      allow read, write: if isOwner();
    }

    match /attendance/{recordId} {
      allow read, write: if isOwner();
    }

    match /fll_progress/{docId} {
      allow read, write: if isOwner();
    }

    match /global_settings/{docId} {
      allow read, write: if isOwner();
    }

    match /robot_status/{docId} {
      allow read, write: if isOwner();
    }

    match /impact_events/{eventId} {
      allow read, write: if isOwner();
    }

    match /judging_feedback/{feedbackId} {
      allow read, write: if isOwner();
    }

    // Shared text-only team memory for referee questions and answers.
    function isTeamMember(teamId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamCreator(teamId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    match /teams/{teamId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if isTeamCreator(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if isTeamCreator(teamId);

      match /members/{memberId} {
        allow read: if isTeamMember(teamId) || (isSignedIn() && memberId == request.auth.uid);
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 180
          && request.resource.data.joinedAt is timestamp;
        allow update: if memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 180
          && request.resource.data.joinedAt is timestamp;
        allow delete: if memberId == request.auth.uid || isTeamCreator(teamId);
      }

      match /questions/{questionId} {
        allow read: if isTeamMember(teamId);
        allow create: if isTeamMember(teamId)
          && request.resource.data.keys().hasOnly([
            'question', 'answer', 'season', 'language', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 2000
          && request.resource.data.answer is string
          && request.resource.data.answer.size() <= 20000
          && request.resource.data.season is string
          && request.resource.data.language is string
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isTeamMember(teamId) && resource.data.authorUid == request.auth.uid;
      }
    }

    // Default deny: anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
