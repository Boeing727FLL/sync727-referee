/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.google.com https://www.gstatic.com https://*.firebaseio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://pub-9b07ff19511b4468a47d28bb2cb58176.r2.dev https://*.r2.dev https://*.cloudflarestorage.com https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com wss://*.googleapis.com https://*.firebaseapp.com https://*.firebaseio.com https://*.cloudflarestorage.com https://pub-9b07ff19511b4468a47d28bb2cb58176.r2.dev https://accounts.google.com https://www.googleapis.com https://www.google.com wss://*.firebaseio.com; frame-src https://accounts.google.com https://www.google.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Root-level artwork is NOT content-hashed: it ships under stable names and
# changes between deploys, so it must revalidate. (Hashed files under
# /assets/* and /fonts/* above keep the year-long immutable cache.)
# The boeing logo png keeps Netlify's default revalidating cache because its
# filename contains characters that cannot be written literally here.
/logoref.webp
  Cache-Control: public, max-age=3600, must-revalidate
/referee-logo.webp
  Cache-Control: public, max-age=3600, must-revalidate
/chat-glow.webp
  Cache-Control: public, max-age=3600, must-revalidate
/chat-glow-tall.webp
  Cache-Control: public, max-age=3600, must-revalidate
/bioglow-table.webp
  Cache-Control: public, max-age=3600, must-revalidate
/AppLogo.png
  Cache-Control: public, max-age=3600, must-revalidate
/logo.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-32.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-48.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-192.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-512.png
  Cache-Control: public, max-age=3600, must-revalidate
